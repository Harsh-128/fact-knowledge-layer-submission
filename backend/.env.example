# Application
APP_NAME=Fact Knowledge Layer
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fact_layer
POSTGRES_USER=fact_user
POSTGRES_PASSWORD=fact_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# LLM
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b

# Optional hosted LLM keys
OPENAI_API_KEY=
GEMINI_API_KEY=

# File storage
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=50
