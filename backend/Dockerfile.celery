FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libmupdf-dev \
    libfreetype6-dev \
    libharfbuzz-dev \
    libjpeg-dev \
    libopenjp2-7-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml ./

RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -e "."

COPY . .

RUN mkdir -p ./storage/uploads

# worker_main.py starts both:
# 1. A tiny HTTP health server (satisfies Render's port requirement)
# 2. The Celery worker (processes PDF tasks)
CMD ["python", "worker_main.py"]
